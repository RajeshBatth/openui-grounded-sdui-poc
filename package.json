{
  "name": "openui-poc",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,api \"vite\" \"tsx watch --env-file-if-exists=.env server/index.ts\"",
    "build": "tsc --noEmit && vite build",
    "prompt": "tsx server/print-prompt.ts",
    "prompt:tokens": "tsx server/prompt-tokens.ts",
    "selftest:sdui": "tsx server/sdui/selftest.ts",
    "bench": "tsx server/bench.ts",
    "report": "tsx server/report.ts",
    "validate": "tsx server/validate-fixtures.ts"
  },
  "dependencies": {
    "@openuidev/lang-core": "^1.0.2",
    "@openuidev/react-lang": "^1.0.2",
    "express": "^5.3.0",
    "gpt-tokenizer": "^4.1.0",
    "openai": "^7.45.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
